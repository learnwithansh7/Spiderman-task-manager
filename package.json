{
  "name": "spiderman-task-manager",
  "version": "2.0.0",
  "description": "Spider-Man Task Manager - Interactive Windows desktop task manager and offline voice companion",
  "main": "dist/electron/main.js",
  "author": "SpiderReminder Team",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "vite build",
    "build": "npm run build:vite && npm run build:electron",
    "test:r0": "npm run build:electron && electron dist/electron/main.js --r0-test",
    "test:r1": "node scripts/dev.js --test-r1",
    "test:r2": "node scripts/dev.js --test-r2",
    "test:r3": "node scripts/dev.js --test-r3",
    "test:r4": "node scripts/dev.js --test-r4",
    "test:r5": "node scripts/dev.js --test-r5",
    "test:r6": "node scripts/dev.js --test-r6",
    "test:r7": "node scripts/dev.js --test-r7",
    "test:r8": "npm run dist:dir",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "start": "npm run build && electron dist/electron/main.js"
  },
  "build": {
    "appId": "com.spiderreminder.app",
    "productName": "SpiderReminder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "scripts/check-fullscreen.ps1",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/voice",
        "to": "tools/voice"
      },
      {
        "from": "models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpiderReminder"
    }
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}